# Postgres connection string. On Vercel, use the Vercel Postgres integration
# or a Neon / Supabase database. Locally, run Postgres in Docker or point at Neon.
DATABASE_URL="postgresql://user:password@host:5432/gameplan_action?sslmode=require"

# 32+ random bytes. In prod, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-in-production"
