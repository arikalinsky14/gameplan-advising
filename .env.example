# On Vercel, the Neon integration writes both of these automatically —
# don't add them by hand there. Locally, paste your Neon connection strings.
#
# POSTGRES_PRISMA_URL is the pooled URL Prisma uses at runtime.
# POSTGRES_URL_NON_POOLING is the direct URL used by `prisma db push`
# and migrations.
POSTGRES_PRISMA_URL="postgresql://user:password@host-pooler.neon.tech/gameplan_action?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host.neon.tech/gameplan_action?sslmode=require"

# 32+ random bytes. In prod, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-in-production"

# CollegeBasketballData API key (optional).
# $10/mo Patreon Tier 3 covers CBD + CFBD together — see docs/PHASE-1-HANDOFF.md § D1.
# With no key set, the schedule strip on the themed home shows a "not configured" note
# instead of crashing.
CBD_API_KEY=""
