// Game Plan Action — Prisma schema
//
// Data model for the internal advisor tool. Every field the intake/tools
// collect lives here. Auth is credentials-based; sessions are JWT cookies
// (see lib/auth.ts), so no separate Session table is needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for runtime queries. On Vercel + Neon this is set by
  // the Neon integration. Locally, set it in .env — or fall back to
  // DATABASE_URL if that's what you already have.
  url       = env("POSTGRES_PRISMA_URL")
  // Direct (unpooled) connection for `prisma db push` and migrations. Neon
  // integration sets this as POSTGRES_URL_NON_POOLING.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// A single login. Either an Advisor or a Client.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // If role = CLIENT, this is the athlete they own.
  athlete       Athlete? @relation("AthleteOwner")

  // Guardians are Users (role = GUARDIAN) with co-access to specific athletes.
  guardianships GuardianAccess[]

  // Every advisor edit is logged for the accuracy feedback loop.
  overrides     Override[]
}

enum Role {
  ADVISOR
  CLIENT
  GUARDIAN
}

// An athlete account. Advisors see the full roster; clients see their own.
model Athlete {
  id             String   @id @default(cuid())
  ownerId        String   @unique
  owner          User     @relation("AthleteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  dob            DateTime?
  classYear      String?
  homeState      String?   // legal domicile — asked directly
  isMinor        Boolean   @default(false)

  sport          String?   // "Men's Football" | "Men's Basketball" | ...
  sportTier      Int?      // 1 | 2
  teamId         String?   // FK-ish to content/teams.ts id
  teamSchool     String?
  teamManualNote String?   // set when the athlete used the "can't find your team" path

  status         IntakeStatus @default(NOT_STARTED)
  flags          String[]     // "state-compliance" | "entity" | "insurance"

  // NIL & tax data
  nilIncomeYtd   Float    @default(0)
  scholarshipTaxable Float @default(0)
  competingStates String[] @default([])
  domicileAmbiguousFlag Boolean @default(false)

  // Related records
  goals          Goal[]
  contracts      Contract[]
  expenses       Expense[]
  taxSnapshots   TaxSnapshot[]
  overrides      Override[]
  guardians      GuardianAccess[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum IntakeStatus {
  NOT_STARTED
  IN_PROGRESS
  PLAN_GENERATED
  SYNCED_TO_EMONEY
}

model GuardianAccess {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([athleteId, userId])
}

// Goals Module — maps 1:1 to eMoney expense records with isGoal: true.
model Goal {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  bucket     GoalBucket
  text       String
  years      String   // e.g. "2026-2027" — free-form fallback for compatibility with early records
  startDate  DateTime?
  endDate    DateTime?
  amount     Float?   // optional; eMoney expects an amount on export

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum GoalBucket {
  SHORT
  MEDIUM
  LONG
}

// Contract & Payment extraction (Section 7-B / 7-H).
//
// NIL income sourcing note (see docs/TAX-CALCULATOR-ACCURACY-GUIDE.md §2/§3):
// NIL contracts are payment for name/image/likeness work, not for athletic
// performance. State income tax is therefore sourced to WHERE the work was
// performed — not to the team's game schedule. Short one-off deals typically
// have a single `workState`. Long-term deals (e.g. a season-long Nike
// campaign) get a WorkLogEntry per session so income allocates across every
// state the athlete actually worked in, in proportion to time spent.
model Contract {
  id             String   @id @default(cuid())
  athleteId      String
  athlete        Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  brand          String
  grossAmount    Float
  agentFeePct    Float    // 0-1
  nonCashFmv     Float    @default(0)
  paymentSchedule String?  // "monthly", "quarterly", "one-time"
  termStart      DateTime?
  termEnd        DateTime?
  exclusivity    String?
  deliverables   String?

  // Simple one-off case: the whole deal was performed in one state. Left
  // null and unconfirmed by default so the sourcing function surfaces it
  // for advisor review rather than silently defaulting to home state.
  workState          String?
  workStateConfirmed Boolean @default(false)

  // Long-term case: a contemporaneous work log. When any entries exist,
  // the sourcing function uses them (state-day proportional split) instead
  // of the single workState field above.
  workLog        WorkLogEntry[]

  // Vault mirror — the original PDF stays alongside the extracted numbers.
  vaultDocumentUrl String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Contemporaneous work-log entry attached to a Contract. Each entry answers
// "on this date, in this state, how many hours did the athlete work on this
// deal." Hours-weighted so a full production day counts more than a 20-minute
// social post. The sourcing function converts entry hours per state into a
// fraction of the deal's net income allocated to that state.
model WorkLogEntry {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  date       DateTime
  state      String   // 2-letter
  city       String?  // free-text, e.g. "Portland" for a shoot day
  hours      Float    @default(1)
  note       String?
  // Proof of completion — Vercel Blob URL (photo, receipt PDF, invoice, etc).
  // Uploaded via /api/upload; stored as the public blob URL. Nullable so
  // legacy entries and quick logs without a file are still valid.
  proofUrl   String?
  proofName  String?  // original filename, for display

  createdAt  DateTime @default(now())
}

// Expense form line items — feeds the deductible-expense side of tool C.
model Expense {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  category   String   // "rent", "training", "recovery", etc.
  amount     Float
  athleteSpecific Boolean @default(false)
  deductible Boolean  @default(false)
  note       String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A saved tax calculation snapshot — jock tax or consolidated. Retained so
// advisors can see how numbers changed run-to-run.
model TaxSnapshot {
  id            String   @id @default(cuid())
  athleteId     String
  athlete       Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  kind          TaxSnapshotKind
  inputJson     Json
  outputJson    Json
  refined       Boolean @default(false)
  createdBy     String?

  createdAt     DateTime @default(now())
}

enum TaxSnapshotKind {
  JOCK_TAX
  CONSOLIDATED
}

// Advisor override log — the accuracy feedback loop from the outline.
model Override {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  advisorId  String
  advisor    User     @relation(fields: [advisorId], references: [id])

  field      String   // dot-path of what was changed, e.g. "goal.amount"
  fromValue  String?
  toValue    String?
  reason     String

  createdAt  DateTime @default(now())
}
